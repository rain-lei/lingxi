# Do not commit real credentials. Export this value in your shell before launch.
STEPFUN_API_KEY=replace_with_your_key
STEPFUN_CHAT_MODEL=step-3.7-flash
STEPFUN_VISION_MODEL=step-3.7-flash
STEPFUN_TTS_VOICE=cixingnansheng
# Optional. Upstream requests fall back after 45 seconds by default.
STEPFUN_TIMEOUT=45
# Optional. Leave empty until a real device is paired.
LINGXI_DEVICE_TOKEN=replace_with_a_random_device_token
